---
import Base from '@/layouts/Base.astro';
import ProductCard from '@/components/ProductCard.astro';
import Deco from '@/components/deco/Deco.astro';
import TornEdge from '@/components/deco/TornEdge.astro';
import { href, routes } from '@/lib/paths';
import { products, isSoldOut } from '@/lib/data';

// Les pièces épinglées pour le live du soir. Dans la version branchée à la
// base, cette liste vient de la console Live et se met à jour toute seule.
const epinglees = products.filter((p) => !isSoldOut(p)).slice(2, 8);
const enCours = false;
---
<Base title="Le live" description="Les pièces montrées pendant nos directs Instagram et Facebook.">
  <section class="relative overflow-hidden bg-ink py-12 text-cream lg:py-16">
    <Deco type="bobine" class="deco deco-lg -start-6 top-10 w-28 text-rose/10 deco-sway" />
    <Deco type="perle" class="deco deco-lg end-4 bottom-8 w-32 text-rose/10" />

    <div class="container-x relative text-center">
      {enCours ? (
        <p class="inline-flex items-center gap-2 rounded-full bg-wine px-4 py-1.5 text-xs font-bold uppercase tracking-wide">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cream opacity-70"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-cream"></span>
          </span>
          En direct maintenant
        </p>
      ) : (
        <p class="inline-flex items-center gap-2 rounded-full bg-cream/10 px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-cream/80">
          Prochain live jeudi, 20 h
        </p>
      )}

      <h1 class="mt-4 text-3xl text-cream sm:text-4xl">Les pièces du live</h1>
      <p class="mx-auto mt-4 max-w-xl text-cream/75">
        {enCours
          ? "Ce que nous montrons en ce moment. La liste se met à jour toute seule."
          : "Voici ce qui sera présenté au prochain direct. Vous pouvez déjà commander."}
      </p>
    </div>
    <TornEdge position="bottom" class="text-cream" height={24} />
  </section>

  <section class="relative py-10 lg:py-14">
    <div class="container-x">
      {epinglees.length === 0 ? (
        <div class="rounded-lg bg-paper p-10 text-center shadow-card">
          <p class="text-ink-2">Aucune pièce épinglée pour le moment.</p>
          <a href={href(routes.shop)} class="btn btn-primary btn-sm mt-4">Voir la boutique</a>
        </div>
      ) : (
        <>
          <div class="reveal flex items-center justify-between gap-4">
            <h2 class="text-2xl">
              {epinglees.length} pièce{epinglees.length > 1 ? 's' : ''} à l'affiche
            </h2>
            <a href={href(routes.shop)} class="shrink-0 text-sm font-semibold text-wine underline underline-offset-4">
              Tout voir
            </a>
          </div>
          <div class="mt-6 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4">
            {epinglees.map((p, i) => <ProductCard product={p} index={i} eager={i < 2} />)}
          </div>
        </>
      )}

      <div class="reveal mt-12 rounded-xl bg-wine-soft p-6 sm:p-8">
        <h2 class="text-xl">Comment ça marche</h2>
        <ol class="mt-4 grid gap-4 sm:grid-cols-3">
          <li class="flex gap-3">
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-wine font-display text-sm font-semibold text-white">1</span>
            <p class="text-sm text-ink-2">Suivez le direct sur Instagram ou Facebook.</p>
          </li>
          <li class="flex gap-3">
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-wine font-display text-sm font-semibold text-white">2</span>
            <p class="text-sm text-ink-2">Ouvrez cette page : les pièces montrées y sont, avec les tailles restantes.</p>
          </li>
          <li class="flex gap-3">
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-wine font-display text-sm font-semibold text-white">3</span>
            <p class="text-sm text-ink-2">Ajoutez au panier et payez. La pièce est à vous.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>
</Base>
