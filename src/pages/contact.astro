---
import Base from '@/layouts/Base.astro';
import InfoPage from '@/components/InfoPage.astro';
import ContactForm from '@/components/islands/ContactForm';
import { brand } from '@/lib/brand';
---
<Base title="Nous écrire" description="Contacter Cokette Girls à Bray-sur-Somme.">
  <InfoPage titre="Nous écrire" intro="Une question sur une taille, une commande, un délai ? Nous répondons vite." deco="perle">
    <div class="not-prose mb-10 grid gap-4 sm:grid-cols-3">
      <a href={`tel:${brand.telephoneLien}`}
        class="flex flex-col items-start gap-1 rounded-lg bg-paper p-5 shadow-card transition-shadow hover:shadow-float">
        <svg class="h-7 w-7 text-wine" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4h3l2 5-2 1.5a12 12 0 0 0 5 5L15 13l5 2v3a2 2 0 0 1-2 2A15 15 0 0 1 4 6a2 2 0 0 1 2-2z" /></svg>
        <span class="mt-1 text-xs font-bold uppercase tracking-wide text-ink-3">Par téléphone</span>
        <span class="font-display text-lg font-semibold text-ink">{brand.telephone}</span>
      </a>
      <a href={`mailto:${brand.email}`}
        class="flex flex-col items-start gap-1 rounded-lg bg-paper p-5 shadow-card transition-shadow hover:shadow-float">
        <svg class="h-7 w-7 text-wine" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
        <span class="mt-1 text-xs font-bold uppercase tracking-wide text-ink-3">Par e-mail</span>
        <span class="break-all text-sm font-semibold text-ink">{brand.email}</span>
      </a>
      <div class="flex flex-col items-start gap-1 rounded-lg bg-paper p-5 shadow-card">
        <svg class="h-7 w-7 text-wine" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s7-7.1 7-12a7 7 0 0 0-14 0c0 4.9 7 12 7 12Z" /><circle cx="12" cy="10" r="2.5" /></svg>
        <span class="mt-1 text-xs font-bold uppercase tracking-wide text-ink-3">En boutique</span>
        <span class="text-sm font-semibold leading-snug text-ink">
          {brand.adresse.rue}
          <span class="block font-normal text-ink-2">{brand.adresse.cp} {brand.adresse.ville}</span>
        </span>
      </div>
    </div>

    <h2>Nous suivre</h2>
    <p>
      C'est là que nous annonçons les lives et les arrivages&nbsp;:
      <a href={brand.reseaux.instagram} rel="noopener noreferrer" target="_blank">Instagram</a>,
      <a href={brand.reseaux.facebook} rel="noopener noreferrer" target="_blank">Facebook</a>
      et <a href={brand.reseaux.tiktok} rel="noopener noreferrer" target="_blank">TikTok</a>.
    </p>

    <h2>Un message</h2>
    <ContactForm client:visible />
  </InfoPage>
</Base>
