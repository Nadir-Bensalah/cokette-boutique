---
import Bientot from '@/components/Bientot.astro';
import { DEMO } from '@/lib/demo';
import Base from '@/layouts/Base.astro';
import InfoPage from '@/components/InfoPage.astro';
import { href, asset, routes } from '@/lib/paths';
import TornEdge from '@/components/deco/TornEdge.astro';
import Picture from '@/components/Picture.astro';
import { brand } from '@/lib/brand';
import Deco from '@/components/deco/Deco.astro';
---
{false ? <Bientot titre="" texte="" /> : (
<Base title="À propos de Rabaa" description="Qui est derrière Cokette Girls, et pourquoi chaque pièce est choisie à la main.">
  <section class="relative overflow-hidden bg-rose-soft py-12 sm:py-16">
    <Deco type="fleur" class="deco deco-lg end-4 top-6 w-24 text-wine/15" />
    <div class="container-x grid items-center gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-14">
      <div class="relative mx-auto w-full max-w-xs lg:max-w-sm">
        <div class="rotate-[-2deg] rounded-2xl bg-paper p-3 shadow-float">
          <Picture src="/images/marque/rabaa-portrait.jpg" alt="Rabaa dans sa boutique" sizes="(min-width: 1024px) 30vw, 80vw" loading="eager" fetchpriority="high" imgClass="aspect-[3/4] w-full rotate-[2deg] rounded-xl object-cover object-top" width={900} height={1600} />
        </div>
      </div>
      <div>
        <p class="eyebrow">À propos de moi</p>
        <h1 class="mt-3 text-3xl leading-[1.05] sm:text-4xl lg:text-5xl">Hey les filles&nbsp;!</h1>
        <p class="mt-5 text-lg text-ink-2">
          Prêtes pour une virée shopping sans bouger du canapé&nbsp;? Ici, chaque pièce est une
          petite pépite dénichée rien que pour vous.
        </p>
        <p class="hand mt-6 text-2xl text-wine">Craque sans compter (ou presque)</p>
      </div>
    </div>
    <TornEdge position="bottom" height={24} class="edge-in text-cream" />
  </section>

  <InfoPage titre="Du style, des prix cool, et zéro culpabilité" intro="On aime le style, les pièces uniques et surtout les prix qui ne font pas mal au porte-monnaie." deco="cintre">
    <p>
      Que vous ayez envie d'un look casual, d'une tenue qui claque ou juste de vous faire
      plaisir, il y a ce qu'il vous faut. Faites un tour, laissez parler vos envies, et craquez.
    </p>
    <p>
      Ici, chaque pièce est dénichée une par une. Pas de collections entières
      commandées sur catalogue&nbsp;: des trouvailles, en petite quantité, choisies
      parce qu'elles nous ont plu. C'est ce qui fait que vous ne croiserez pas votre
      tenue partout.
    </p>
    <p>
      Et le style ne devrait pas coûter un mois de salaire. Nos prix restent ceux
      d'une boutique de quartier, parce que c'est ce que nous sommes.
    </p>

    <h2>Les lives</h2>
    <p>
      Nous présentons les arrivages en live. Suivez-nous sur
      <a href={brand.reseaux.instagram} rel="noopener noreferrer" target="_blank">Instagram</a>,
      <a href={brand.reseaux.facebook} rel="noopener noreferrer" target="_blank">Facebook</a>
      et <a href={brand.reseaux.tiktok} rel="noopener noreferrer" target="_blank">TikTok</a>.
      Vous voyez les matières, les tombés, vous posez vos questions, et vous commandez
      depuis <a href={href(routes.live)}>la page live</a> sans attendre la fin.
    </p>

    <h2>Venir nous voir</h2>
    <table>
      <tbody>
        <tr><th>Adresse</th><td>{brand.adresse.rue}, {brand.adresse.cp} {brand.adresse.ville}</td></tr>
        <tr><th>Horaires</th><td>À confirmer</td></tr>
        <tr><th>Téléphone</th><td><a href={`tel:${brand.telephoneLien}`}>{brand.telephone}</a></td></tr>
        <tr><th>E-mail</th><td><a href={`mailto:${brand.email}`}>{brand.email}</a></td></tr>
      </tbody>
    </table>

    <h2>Le retrait en boutique</h2>
    <p>
      Commandez en ligne et venez chercher votre pièce&nbsp;: <strong>c'est gratuit</strong>,
      disponible dès le lendemain, et vous pouvez l'essayer sur place. Si la taille ne
      va pas, on échange tout de suite.
    </p>

    <h2>Un doute sur la taille</h2>
    <p>
      Écrivez-nous avant de commander en nous disant la pièce qui vous intéresse et
      vos mesures. Nous vous dirons ce qui convient. C'est plus simple qu'un retour.
      Le <a href={href('/guide-des-tailles')}>guide des tailles</a> donne déjà les
      correspondances.
    </p>

    <h2>L'entreprise</h2>
    <p>
      {brand.nom} est une {brand.statut.toLowerCase()} immatriculée sous le
      SIRET {brand.siret}, dont le siège est au {brand.adresse.complet}.
      Les <a href={href(routes.legal)}>mentions légales</a> donnent le détail.
    </p>
  </InfoPage>
</Base>
)}
