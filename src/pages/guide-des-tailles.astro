---
import Bientot from '@/components/Bientot.astro';
import { DEMO } from '@/lib/demo';
import Base from '@/layouts/Base.astro';
import InfoPage from '@/components/InfoPage.astro';
---
{DEMO ? <Bientot titre="Le guide des tailles" texte="Le guide des tailles arrive avec la version complète." /> : (
<Base title="Guide des tailles" description="Trouver la bonne taille chez Cokette Girls.">
  <InfoPage titre="Guide des tailles" intro="Un mètre de couturière, deux minutes, et plus de doute." deco="aiguille">
    <h2>Vêtements</h2>
    <table>
      <thead><tr><th>Taille</th><th>Poitrine</th><th>Taille</th><th>Hanches</th></tr></thead>
      <tbody>
        <tr><td>S</td><td>84 – 88 cm</td><td>66 – 70 cm</td><td>92 – 96 cm</td></tr>
        <tr><td>M</td><td>88 – 92 cm</td><td>70 – 74 cm</td><td>96 – 100 cm</td></tr>
        <tr><td>L</td><td>92 – 97 cm</td><td>74 – 79 cm</td><td>100 – 105 cm</td></tr>
        <tr><td>XL</td><td>97 – 103 cm</td><td>79 – 85 cm</td><td>105 – 111 cm</td></tr>
      </tbody>
    </table>
    <h2>Comment se mesurer</h2>
    <ul>
      <li><strong>Poitrine</strong>&nbsp;: à l'endroit le plus fort, le mètre bien horizontal.</li>
      <li><strong>Taille</strong>&nbsp;: au creux, au-dessus du nombril.</li>
      <li><strong>Hanches</strong>&nbsp;: à l'endroit le plus large, environ 20 cm sous la taille.</li>
    </ul>
    <p>
      Mesurez-vous en sous-vêtements, sans serrer. Entre deux tailles, prenez la plus grande
      pour une coupe ample, la plus petite pour un tombé ajusté.
    </p>
    <h2>Un doute&nbsp;?</h2>
    <p>
      Écrivez-nous en indiquant la pièce qui vous intéresse et vos mesures&nbsp;: nous vous
      dirons ce qui convient. C'est plus sûr qu'un retour.
    </p>
  </InfoPage>
</Base>
)}
