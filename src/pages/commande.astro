---
import Bientot from '@/components/Bientot.astro';
import { DEMO } from '@/lib/demo';
import Base from '@/layouts/Base.astro';
import Checkout from '@/components/islands/Checkout';
---
{DEMO ? <Bientot titre="Le paiement" texte="Le tunnel de commande et le paiement Stripe arrivent avec la version complète." /> : (
<Base title="Votre commande" noBottomBar>
  <section class="py-8 lg:py-12">
    <div class="container-x max-w-4xl">
      <h1 class="text-3xl sm:text-4xl">Votre commande</h1>
      <p class="mt-2 text-ink-2">Quelques informations, et c'est réglé.</p>
      <Checkout client:load base={import.meta.env.BASE_URL} />
    </div>
  </section>
</Base>
)}
