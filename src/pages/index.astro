  .dot.is-on { background: var(--color-wine); }
</style>

<script>
  // Le carrousel des coups de cœur : flèches, points, et le point actif qui
  // suit le défilement. Tout marche déjà sans ce script (défilement tactile).
  const track = document.querySelector<HTMLElement>('[data-deals-track]');
  if (track) {
    const dots = Array.from(document.querySelectorAll<HTMLElement>('[data-deals-dots] span'));
    const pas = () => track.querySelector('li')?.getBoundingClientRect().width ?? 320;

    document.querySelector('[data-deals-prev]')?.addEventListener('click', () =>
      track.scrollBy({ left: -pas() - 20, behavior: 'smooth' }));
    document.querySelector('[data-deals-next]')?.addEventListener('click', () =>
      track.scrollBy({ left: pas() + 20, behavior: 'smooth' }));

    let tick = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(tick);
      tick = requestAnimationFrame(() => {
        const i = Math.round(track.scrollLeft / (pas() + 20));
        dots.forEach((d, n) => d.classList.toggle('is-on', n === i));
      });
    }, { passive: true });
  }

  // Le carrousel des avis : même mécanique, sa propre piste.
  const avisTrack = document.querySelector<HTMLElement>('[data-avis-track]');
  if (avisTrack) {
    const dots = Array.from(document.querySelectorAll<HTMLElement>('[data-avis-dots] span'));
    const pas = () => avisTrack.querySelector('li')?.getBoundingClientRect().width ?? 340;

    document.querySelector('[data-avis-prev]')?.addEventListener('click', () =>
      avisTrack.scrollBy({ left: -pas() - 24, behavior: 'smooth' }));
    document.querySelector('[data-avis-next]')?.addEventListener('click', () =>
      avisTrack.scrollBy({ left: pas() + 24, behavior: 'smooth' }));

    let t2 = 0;
    avisTrack.addEventListener('scroll', () => {
      cancelAnimationFrame(t2);
      t2 = requestAnimationFrame(() => {
        const i = Math.round(avisTrack.scrollLeft / (pas() + 24));
        dots.forEach((d, n) => d.classList.toggle('is-on', n === i));
      });
    }, { passive: true });
  }
</script>
