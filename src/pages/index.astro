---
import Base from '@/layouts/Base.astro';
import ProductCard from '@/components/ProductCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import Deco from '@/components/deco/Deco.astro';
import TornEdge from '@/components/deco/TornEdge.astro';
import TrustBar from '@/components/TrustBar.astro';
import Voile from '@/components/deco/../Voile.astro';
import { DEMO } from '@/lib/demo';
import AddButton from '@/components/islands/AddButton';
import { href, asset, routes } from '@/lib/paths';
import { categories, products, formatPrice, isSoldOut, isLow, availableSizes, newArrivals } from '@/lib/data';

const dispo = products.filter((p) => !isSoldOut(p));
const coupsDeCoeur = dispo.slice(0, 6);
const vedettes = dispo.slice(6, 12);
const nouveautes = newArrivals().slice(0, 4);
const heroImg = dispo[0]?.images[0];
const portrait = dispo[3]?.images[0] ?? heroImg;
// Le fond du hero : une photo qui a du décor derrière elle. Un vêtement sur
// fond uni, une fois flouté, ne donne qu'un aplat. Inutile de l'y mettre.
const fondHero =
  dispo.find((x) => x.images.length >= 3 && x.slug !== dispo[0]?.slug)?.images[1]
  ?? dispo[2]?.images[0] ?? heroImg;
const catsVisibles = categories.filter((c) => c.slug !== 'nouveautes');

// Une icône de mercerie par rayon.
const ICONES: Record<string, any> = {
  robes: 'cintre', hauts: 'bouton', bas: 'ruban',
  vestes: 'aiguille', chaussures: 'noeud', accessoires: 'perle',
};
const PHRASES: Record<string, string> = {
  robes: 'Pour un dîner ou pour un mardi',
  hauts: 'Ceux qu’on remet sans y penser',
  bas: 'Fluides, ballon, taille haute',
  vestes: 'La pièce qui tient la silhouette',
  chaussures: 'Du matin jusqu’au soir',
  accessoires: 'Le détail qui change tout',
};

const badgesHero = [
  { i: 'boutique' as const, t: 'Retrait gratuit', s: 'à Bray-sur-Somme' },
  { i: 'camion' as const, t: 'Expédition 48 h', s: 'Colissimo ou relais' },
  { i: 'echange' as const, t: '14 jours', s: 'pour changer d’avis' },
];

const etapes = [
  { i: 'live' as const, t: 'On présente en live', x: 'Plusieurs fois par semaine, sur Instagram et Facebook.' },
  { i: 'taille' as const, t: 'Vous choisissez la taille', x: 'Le stock affiché est le vrai : ce qui est là est à vous.' },
  { i: 'paiement' as const, t: 'Vous payez en ligne', x: 'Carte, Apple Pay ou Google Pay. En quelques secondes.' },
  { i: 'colis' as const, t: 'Vous recevez ou vous passez', x: 'Chez vous sous 48 h, ou en boutique dès le lendemain.' },
];

const avis = [
  { n: 'Sandrine', v: 'Commandé pendant le live du jeudi, récupéré le vendredi en boutique. Encore plus jolie en vrai.' },
  { n: 'Élodie', v: 'Enfin un site où je vois tout de suite si ma taille est dispo. Ça change tout.' },
  { n: 'Marie', v: 'J’ai pris une taille au-dessus sur ses conseils. C’était le bon choix.' },
  { n: 'Céline', v: 'Colis reçu en deux jours, emballé avec un petit mot. On sent que c’est fait à la main.' },
];

const stats = [
  { v: '+400', l: 'clientes' },
  { v: '4,9/5', l: 'satisfaction' },
  { v: '2019', l: 'depuis' },
];

const chiffres = [
  { v: '2019', l: 'La boutique ouvre', x: 'À Bray-sur-Somme, rue principale.' },
  { v: '22', l: 'Pièces en ligne', x: 'Choisies une par une, en petite quantité.' },
  { v: '48 h', l: 'Pour être livrée', x: 'Ou dès le lendemain en retrait.' },
  { v: '2×', l: 'Lives par semaine', x: 'Le mardi et le jeudi, à 20 h.' },
];
---

<Base ownTrustBar>
  <!-- Ouverture : le texte à gauche, la pièce montrée en entier à droite.
       Les photos de la boutique sont des portraits serrés : en fond plein
       écran elles ne montrent qu'un morceau. On les cadre au lieu de les subir. -->
  <section class="relative isolate overflow-hidden text-cream">
    <!-- Le fond : une photo de la boutique, floutée et assombrie. Elle donne la
         matière et la couleur ; le sujet reste la pièce cadrée à droite. -->
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <img src={asset(`/images/products/${fondHero}`)} alt="" width="1200" height="800"
        fetchpriority="high" decoding="async"
        class="h-full w-full scale-110 object-cover blur-xl" />
      <div class="absolute inset-0 bg-wine-deep/60"></div>
      <div class="absolute inset-0 bg-gradient-to-br from-wine-deep/75 via-wine-deep/35 to-wine/20"></div>
    </div>
    <div class="pointer-events-none absolute inset-0 -z-10 opacity-[0.08]" aria-hidden="true"
      style="background-image:radial-gradient(circle at 1px 1px, #fff 1px, transparent 0);background-size:26px 26px"></div>
    <Deco type="dentelle" class="deco deco-lg -start-16 bottom-0 w-72 text-rose/15" />

    <div class="container-x relative grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:py-24">
      <div>
        <p class="reveal eyebrow text-rose">Bray-sur-Somme</p>
        <h1 class="reveal mt-4 leading-[0.98] text-cream"
          style="--reveal-delay: 80ms; font-size: clamp(2.5rem, 6.5vw, 4.75rem)">
          La mode qui vous <span class="italic font-normal text-rose">ressemble</span>.
        </h1>
        <p class="reveal mt-5 max-w-lg text-base text-cream/85 sm:text-xl" style="--reveal-delay: 160ms">
          Des pièces choisies une par une, en boutique et en live.
          Retrait gratuit à Bray, ou livraison chez vous.
        </p>
        <div class="reveal mt-7 flex flex-col gap-3 sm:flex-row" style="--reveal-delay: 240ms">
          <a href={href(routes.shop)} class="btn btn-lg bg-cream text-ink hover:bg-rose">
            Voir la boutique
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a href="#comment" class="btn btn-lg border border-cream/40 bg-cream/10 text-cream backdrop-blur-sm hover:bg-cream/20">
            Comment ça marche
          </a>
        </div>

        <ul class="reveal scrollbar-none mask-fade-x -mx-4 mt-8 flex snap-x snap-mandatory items-center gap-6 overflow-x-auto px-4 sm:mx-0 sm:mt-10 sm:flex-wrap sm:gap-x-9 sm:overflow-visible sm:px-0"
          style="--reveal-delay: 320ms">
          {badgesHero.map((b) => (
            <li class="flex shrink-0 snap-start items-center gap-2.5 sm:gap-3">
              <Icon name={b.i} class="h-7 w-7 shrink-0 text-rose sm:h-8 sm:w-8" strokeWidth={1.4} />
              <span class="text-[13px] font-bold leading-tight text-cream sm:text-[15px]">
                {b.t}
                <span class="block font-semibold text-cream/70">{b.s}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>

      <!-- La pièce, cadrée en entier, posée de travers comme une polaroid. -->
      <div class="reveal relative mx-auto w-full max-w-sm lg:max-w-md" style="--reveal-delay:120ms">
        <p class="hand pointer-events-none absolute -start-6 -top-8 z-20 w-44 -rotate-6 text-2xl font-semibold leading-tight text-rose sm:-start-12 sm:text-[1.7rem]" aria-hidden="true">
          Nouveautés chaque semaine
          <svg class="ms-16 mt-1 h-9 w-14 text-rose" viewBox="0 0 64 40" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4c10 12 24 22 44 28M48 32l-11 1M48 32l-3-10" /></svg>
        </p>
        <div class="relative rotate-2 rounded-2xl bg-rose p-3 shadow-float">
          <img src={asset(`/images/products/${heroImg}`)} alt="Une pièce de la collection Cokette Girls"
            width="900" height="1200" fetchpriority="high" decoding="async"
            class="hero-zoom aspect-[3/4] w-full -rotate-2 rounded-xl object-cover" />
        </div>
        <span class="absolute -bottom-4 -end-3 z-20 rounded-full bg-cream px-4 py-2 text-sm font-bold text-ink shadow-card sm:-end-6">
          22 pièces en ligne
        </span>
      </div>
    </div>
    <TornEdge position="bottom" height={24} class="edge-in text-wine" />
  </section>

  <TrustBar />

  <!-- Les coups de cœur : carrousel, pastilles rondes penchées, notes à la main. -->
  <section class="relative overflow-hidden bg-cream py-16 sm:py-20 lg:py-24">
    <Deco type="aiguille" class="deco deco-lg start-10 top-44 w-12 -rotate-12 text-wine/25" />
    <p class="hand pointer-events-none absolute start-16 top-10 hidden -rotate-6 text-2xl font-semibold leading-tight text-wine lg:block xl:start-24" aria-hidden="true">
      Les préférées du moment
      <svg class="ms-24 mt-1 h-10 w-12 text-wine" viewBox="0 0 48 40" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6c14 2 26 12 34 28M30 30l8 4 2-9" /></svg>
    </p>
    <p class="hand pointer-events-none absolute end-16 top-10 hidden rotate-6 text-2xl font-semibold leading-tight text-wine lg:block xl:end-24" aria-hidden="true">
      Stock réel ♡
      <svg class="mt-1 h-3 w-40 text-wine" viewBox="0 0 160 12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M3 8c40-6 90-6 154-2" /></svg>
    </p>
    <img src={asset('/images/marque/fleurs.png')} alt="" width="460" height="378"
      loading="lazy" decoding="async"
      class="deco deco-lg -bottom-6 -start-10 w-56 -scale-x-100 opacity-70 xl:w-72" />
    <img src={asset('/images/marque/fleurs-2.png')} alt="" width="460" height="396"
      loading="lazy" decoding="async"
      class="deco deco-lg -bottom-6 -end-8 w-56 opacity-70 xl:w-72" />

    <div class="mx-auto w-full max-w-[1600px] px-4 sm:px-6 lg:px-24 xl:px-32">
      <div class="reveal text-center">
        <p class="eyebrow inline-flex items-center gap-2 justify-center">
          <Icon name="coeur" class="h-5 w-5 text-wine" strokeWidth={1.8} />
          Coups de cœur
        </p>
        <h2 class="mt-3 text-3xl leading-[1.05] sm:text-4xl lg:text-5xl">Celles qui partent le plus vite.</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-ink-2">
          Ce que nos clientes emportent le plus souvent. Quand c'est parti, c'est parti.
        </p>
      </div>

      <div class="relative mt-10">
        <button type="button" class="deals-arrow -start-4 lg:-start-16 xl:-start-20" data-deals-prev aria-label="Précédent">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg>
        </button>
        <button type="button" class="deals-arrow -end-4 lg:-end-16 xl:-end-20" data-deals-next aria-label="Suivant">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
        </button>

        <ul class="scrollbar-none flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-4 pt-4 sm:px-6 lg:px-2 xl:gap-6" data-deals-track>
          {coupsDeCoeur.map((p, i) => {
            const tailles = availableSizes(p);
            const tag = isLow(p)
              ? { label: 'Dernière pièce', cls: 'bg-wine text-white' }
              : p.badges.includes('nouveau')
                ? { label: 'Nouveau', cls: 'bg-gold-soft text-gold' }
                : { label: tailles.length + ' tailles', cls: 'bg-rose text-ink' };
            return (
              <li class:list={['reveal relative w-[80vw] max-w-[20rem] shrink-0 snap-center rounded-3xl p-4 sm:w-[46%] lg:w-[31%] lg:max-w-none', i % 2 ? 'bg-cream-2' : 'bg-wine-soft']}
                style={`--reveal-delay:${i * 80}ms`}>
                <Deco type="epingle" class="deal-spark" />
                <a href={href(routes.product(p.slug))} class="deal-photo block overflow-hidden" tabindex="-1" aria-hidden="true">
                  <img src={asset(`/images/products/${p.images[0]}`)} alt="" width="800" height="1000" loading="lazy" decoding="async"
                    class="aspect-[4/5] w-full object-cover transition-transform duration-700 hover:scale-105" />
                </a>
                <span class:list={['deal-tag', tag.cls]} aria-hidden="true">{tag.label}</span>
                <div class="relative mt-4 px-2 pb-1">
                  <h3 class="pe-12 text-xl leading-tight">
                    <a href={href(routes.product(p.slug))}>{p.name}</a>
                  </h3>
                  <p class="mt-1.5 pe-12 text-sm leading-snug text-ink-2">{p.short}</p>
                  <p class="mt-3 font-display text-2xl font-semibold text-wine tabular">{formatPrice(p.price)}</p>
                  <div class="mt-3">
                    <AddButton client:visible
                      product={{ id: p.id, slug: p.slug, name: p.name, image: p.images[0] ?? '', price: p.price, sizes: p.sizes, stock: p.stock }}
                      base={import.meta.env.BASE_URL} className="min-h-12 gap-2 text-[15px]" />
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
        <div class="mt-1 flex justify-center gap-2" data-deals-dots aria-hidden="true">
          {coupsDeCoeur.map((_, i) => (
            <span class:list={['dot h-2.5 w-2.5 rounded-full transition-colors', i === 0 && 'is-on']} />
          ))}
        </div>
      </div>

      <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-4 text-start">
        {[['Retrait gratuit', 'Dès le lendemain à Bray'], ['Livraison offerte', 'Dès 80 € d’achat'], ['Conseil taille', 'Écrivez-nous, on répond']].map(([a, s], i) => (
          <li class:list={['flex items-center gap-3', i > 0 && 'lg:border-s lg:border-line-2 lg:ps-8']}>
            <Icon name={(['boutique', 'camion', 'telephone'] as const)[i]!} class="h-10 w-10 shrink-0 text-wine" strokeWidth={1.5} />
            <span>
              <span class="block text-base font-bold leading-tight text-ink">{a}</span>
              <span class="text-sm text-ink-3">{s}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
    <TornEdge position="bottom" height={26} class="edge-in text-cream-2" />
  </section>

{DEMO ? (
  <Voile titre="Les rayons" teinte="cream" hauteur="24rem" />
  ) : (
  <!-- Les rayons : cartes horizontales, photo en galet peint. -->
  <section class="filigree relative overflow-hidden bg-cream-2 py-16 sm:py-20">
    <Deco type="dentelle" class="deco deco-lg end-0 top-4 w-24 rotate-6 text-wine/20" />
    <div class="container-x">
      <SectionHead eyebrow="Par envie" title="Qu'est-ce qui vous ferait plaisir ?"
        text="Six rayons, pour trouver sans chercher."
        link={{ href: href(routes.shop), label: 'Tout voir' }} />
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
        {catsVisibles.map((c, i) => {
          const photo = products.find((p) => p.category === c.slug && p.images.length)?.images[0];
          return (
            <li class="reveal" style={`--reveal-delay:${i * 60}ms`}>
              <a href={href(routes.category(c.slug))}
                class="group flex items-center gap-3 rounded-xl bg-paper p-3 pe-4 shadow-card transition-shadow hover:shadow-float sm:gap-4 sm:p-4 sm:pe-5">
                <div class="w-[42%] shrink-0">
                  <div class={i % 2 ? 'blob-2' : 'blob'}>
                    <img src={asset(`/images/products/${photo}`)} alt="" width="600" height="600" loading="lazy" decoding="async"
                      class="aspect-square w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105" />
                  </div>
                </div>
                <div class="min-w-0 flex-1">
                  <h3 class="text-balance text-lg leading-tight sm:text-xl">{c.name}</h3>
                  <p class="mt-1 line-clamp-2 text-sm text-ink-3">{PHRASES[c.slug]}</p>
                </div>
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-cream text-wine shadow-card transition-colors group-hover:bg-wine group-hover:text-white" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
    <TornEdge position="bottom" height={26} class="edge-in text-paper" />
  </section>

  )}

  <!-- Les nouveautés -->
  {nouveautes.length > 0 && (
    <section class="relative overflow-hidden bg-paper py-16 sm:py-20">
      <Deco type="fleur" class="deco deco-lg -start-6 top-16 w-24 text-wine/15 deco-sway" />
      <div class="container-x">
        <SectionHead eyebrow="Tout juste arrivé" title="Les nouveautés"
          text="Les dernières pièces entrées en boutique."
          link={{ href: href(routes.category('nouveautes')), label: 'Tout voir' }} />
        <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
          {nouveautes.map((p, i) => <ProductCard product={p} index={i} eager={i < 2} />)}
        </div>
      </div>
      <TornEdge position="bottom" variant="vague" height={28} class="edge-in text-rose-soft" />
    </section>
  )}

{DEMO ? (
  <Voile titre="Comment ça marche" teinte="rose" hauteur="26rem" />
  ) : (
  <!-- Comment ça marche : le trait se dessine au défilement. -->
  <section id="comment" class="relative scroll-mt-20 overflow-hidden bg-rose-soft py-16 sm:py-20">
    <Deco type="ruban" class="deco deco-sway deco-lg start-4 top-10 w-24 -rotate-6 text-wine/20" />
    <img src={asset('/images/marque/attente.png')} alt="" width="560" height="784"
      loading="lazy" decoding="async"
      class="deco hidden xl:block end-2 bottom-0 w-40 opacity-90 2xl:w-48" />
    <div class="container-x">
      <SectionHead eyebrow="En quatre temps" title="Du live à votre dressing." align="center"
        text="Pas de compte obligatoire, pas de formulaire à rallonge." />
      <div class="relative mt-12">
        <svg class="draw-path reveal pointer-events-none absolute start-6 top-4 block h-[calc(100%-2rem)] w-px lg:hidden" viewBox="0 0 2 100" preserveAspectRatio="none" aria-hidden="true">
          <path d="M1 0V100" pathLength="1" stroke="var(--color-wine)" stroke-width="3" fill="none" vector-effect="non-scaling-stroke" />
        </svg>
        <svg class="draw-path reveal pointer-events-none absolute inset-x-0 top-8 hidden h-10 w-full lg:block" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true">
          <path d="M60 20 C 200 -10, 300 50, 440 20 S 700 -10, 940 20" pathLength="1" stroke="var(--color-wine)" stroke-width="3" fill="none" vector-effect="non-scaling-stroke" />
        </svg>

        <ol class="relative grid gap-8 lg:grid-cols-4 lg:gap-6">
          {etapes.map((s, i) => (
            <li class="reveal relative flex gap-5 lg:flex-col lg:items-center lg:text-center" style={`--reveal-delay:${i * 120}ms`}>
              <span class="step-badge" aria-hidden="true">
                <Icon name={s.i} class="h-6 w-6 text-wine lg:h-7 lg:w-7" strokeWidth={1.6} />
                <span class="step-rank">{i + 1}</span>
              </span>
              <div class="pt-2 lg:pt-0">
                <p class="eyebrow mb-1">Étape {i + 1}</p>
                <h3 class="text-xl leading-tight">{s.t}</h3>
                <p class="mt-2 text-ink-2">{s.x}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="reveal mt-12 flex flex-col items-center gap-4 text-center sm:flex-row sm:justify-center sm:gap-6 sm:text-start" style="--reveal-delay: 200ms">
          <Icon name="carte" class="h-14 w-14 shrink-0 text-wine" strokeWidth={1.4} />
          <p class="max-w-md text-lg font-semibold text-wine">
            Paiement sécurisé par Stripe. Vos coordonnées bancaires ne passent jamais par ce site.
          </p>
        </div>
      </div>
    </div>
    <TornEdge position="bottom" height={26} class="edge-in text-cream" />
  </section>

  )}

{DEMO ? (
  <Voile titre="La boutique, son histoire, ses chiffres" teinte="cream" hauteur="30rem" />
  ) : (
  <!-- La boutique : portrait en galet, chiffres, bouton. -->
  <section class="relative overflow-hidden bg-cream py-16 sm:py-20 lg:py-28">
    <div class="mx-auto grid w-full max-w-[1600px] items-center gap-14 px-4 sm:px-6 lg:grid-cols-[1fr_1.1fr] lg:gap-16 lg:px-10 xl:gap-24 xl:px-12">
      <div class="reveal relative pt-20 sm:pt-24">
        <p class="hand pointer-events-none absolute start-2 top-2 z-20 w-56 -rotate-3 text-3xl font-semibold leading-tight text-wine" aria-hidden="true">
          Depuis 2019 à Bray
        </p>
        <Deco type="ruban" class="deco -end-6 top-10 z-10 w-36 -rotate-[100deg] text-rose/50" />
        <Deco type="ruban" class="deco -start-10 bottom-6 z-10 w-36 rotate-[150deg] text-rose/50" />
        <div class="blob-2 visual-blob rotate-1">
          <img src={asset(`/images/products/${portrait}`)} alt="La boutique Cokette Girls à Bray-sur-Somme"
            width="1400" height="1400" loading="lazy" decoding="async" class="aspect-square w-full object-cover" />
        </div>
        <div class="absolute bottom-6 start-8 z-20 flex items-center gap-3 rounded-lg bg-gold-soft px-5 py-3 shadow-card sm:start-12">
          <svg class="h-9 w-9 shrink-0 text-wine" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 22s7-7.1 7-12a7 7 0 0 0-14 0c0 4.9 7 12 7 12Z" /><circle cx="12" cy="10" r="2.6" fill="#fff" />
          </svg>
          <span class="text-sm font-bold leading-tight text-ink">
            Bray-sur-Somme
            <span class="block font-semibold text-ink-2">Du mardi au samedi</span>
          </span>
        </div>
      </div>

      <div class="relative">
        <img src={asset('/images/marque/medaillon.png')} alt="Cokette Girls by Rabaa"
          width="800" height="533" loading="lazy" decoding="async"
