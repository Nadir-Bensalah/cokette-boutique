---
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class={cls} viewBox="0 0 220 44" role="img" aria-label="Cokette Girls">
  <!-- Un cintre stylisé, puis le nom. -->
  <g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="20" cy="12" r="4" />
    <path d="M20 16v4" />
    <path d="M20 20 L6 33q-1.6 1.6.8 1.6h26.4q2.4 0 .8-1.6z" />
  </g>
  <text x="44" y="30" font-family="Fraunces, Georgia, serif" font-size="23" font-weight="600" fill="currentColor">Cokette</text>
  <text x="152" y="30" font-family="Fraunces, Georgia, serif" font-size="23" font-weight="400" font-style="italic" fill="currentColor">Girls</text>
</svg>
