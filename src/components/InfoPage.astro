---
import Deco from '@/components/deco/Deco.astro';
interface Props { titre: string; intro?: string; deco?: any }
const { titre, intro, deco = 'ruban' } = Astro.props;
---
<section class="relative py-8 lg:py-14">
  <Deco type={deco} class="deco deco-lg end-0 top-6 w-32 text-wine/10" />
  <div class="container-x relative max-w-3xl">
    <h1 class="text-3xl sm:text-4xl">{titre}</h1>
    {intro && <p class="mt-3 text-lg text-ink-2">{intro}</p>}
    <div class="prose-cokette mt-8">
      <slot />
    </div>
  </div>
</section>
