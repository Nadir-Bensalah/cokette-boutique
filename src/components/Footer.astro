---
import { href, routes } from '@/lib/paths';
import Logo from '@/components/Logo.astro';
import Deco from '@/components/deco/Deco.astro';

const cols = [
  { titre: 'La boutique', liens: [
    { l: 'Toutes les pièces', p: routes.shop },
    { l: 'Nouveautés', p: routes.category('nouveautes') },
    { l: 'Les lives', p: routes.live },
    { l: 'Guide des tailles', p: '/guide-des-tailles' },
  ]},
  { titre: 'Nous connaître', liens: [
    { l: 'La boutique', p: routes.about },
    { l: 'Nous écrire', p: routes.contact },
    { l: 'Mon compte', p: routes.account },
  ]},
  { titre: 'Informations', liens: [
    { l: 'Conditions de vente', p: routes.terms },
    { l: 'Livraison et retours', p: '/livraison-retours' },
    { l: 'Mentions légales', p: routes.legal },
    { l: 'Confidentialité', p: routes.privacy },
  ]},
];
---
<footer class="relative overflow-hidden bg-ink text-cream">
  <Deco type="dentelle" class="deco deco-lg -start-10 top-8 w-40 text-rose/10 deco-sway" />
  <Deco type="perle" class="deco deco-lg end-6 bottom-10 w-36 text-rose/10" />

  <div class="container-x relative py-12 lg:py-16">
    <div class="grid gap-10 md:grid-cols-4">
      <div>
        <Logo class="h-9 w-auto text-cream" />
        <p class="mt-4 max-w-xs text-sm text-cream/70">
          Prêt-à-porter féminin à Bray-sur-Somme. Retrouvez-nous en boutique, ou en live sur nos réseaux.
        </p>
        <div class="mt-5 flex gap-2">
          <a href="https://www.facebook.com/" aria-label="Facebook" rel="noopener noreferrer" target="_blank"
            class="grid h-10 w-10 place-items-center rounded-full bg-cream/10 transition-colors hover:bg-wine">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h2.5l.5-3H13v-2c0-.6.4-1 1-1z"/></svg>
          </a>
          <a href="https://www.instagram.com/" aria-label="Instagram" rel="noopener noreferrer" target="_blank"
            class="grid h-10 w-10 place-items-center rounded-full bg-cream/10 transition-colors hover:bg-wine">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
              <rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="3.8"/><circle cx="17" cy="7" r="1.2" fill="currentColor"/></svg>
          </a>
        </div>
      </div>

      {cols.map((c) => (
        <nav aria-label={c.titre}>
          <h2 class="font-display text-base font-semibold text-cream">{c.titre}</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {c.liens.map((x) => (
              <li><a href={href(x.p)} class="text-cream/70 transition-colors hover:text-cream">{x.l}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-10 flex flex-col justify-between gap-3 border-t border-cream/15 pt-6 text-xs text-cream/50 sm:flex-row">
      <p>© {new Date().getFullYear()} Cokette Girls · Bray-sur-Somme</p>
      <p>Paiement sécurisé par Stripe</p>
    </div>
  </div>
</footer>
