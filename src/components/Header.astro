---
import { href, routes } from '@/lib/paths';
import CartBadge from '@/components/islands/CartBadge';
import CompteLien from '@/components/islands/CompteLien';
import Logo from '@/components/Logo.astro';

const nav = [
  { label: 'Boutique', path: routes.shop },
  { label: 'Nouveautés', path: routes.category('nouveautes') },
  { label: 'Live', path: routes.live },
  { label: 'La boutique', path: routes.about },
];
const here = Astro.url.pathname.replace(/\/$/, '');
---

<header class="sticky top-0 z-40 border-b border-line bg-cream/90 backdrop-blur-md" style="height:var(--header-h)">
  <div class="container-x flex h-full items-center justify-between gap-4">
    <a href={href(routes.home)} class="flex items-center gap-2" aria-label="Cokette Girls, accueil">
      <Logo class="h-8 w-auto text-wine" />
    </a>

    <nav class="hidden lg:block" aria-label="Navigation principale">
      <ul class="flex items-center gap-1">
        {nav.map((n) => {
          const actif = here === href(n.path).replace(/\/$/, '');
          return (
            <li>
              <a href={href(n.path)}
                aria-current={actif ? 'page' : undefined}
                class:list={['rounded-full px-4 py-2 text-sm font-semibold transition-colors',
                  actif ? 'bg-wine text-white' : 'text-ink-2 hover:bg-wine-soft hover:text-wine']}>
                {n.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <CompteLien client:idle base={import.meta.env.BASE_URL} />
      <CartBadge client:load />
    </div>
  </div>
</header>
